---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { Picture } from 'astro:assets';
import landscape from '../assets/solar-landscape.jpg';
import { publishedArticles, originalArticles } from '../lib/server/articles';
export const prerender=false;
let articles=originalArticles;
try {articles=await publishedArticles();} catch {Astro.response.headers.set('Cache-Control','no-store');}
---
<Layout title="Solarna energija za vaš dom – informacije, vodiči i kalkulator" description="Sve o solarnim panelima na jednom mjestu. Istražite vodiče, informirajte se o poticajima i izračunajte potencijal vlastite solarne elektrane.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><div class="eyebrow"><span></span> INFORMIRAJTE SE. IZRAČUNAJTE. ODLUČITE.</div><h1>Sunčeva energija.<br/>Pametna odluka.<br/><span>Održiva budućnost.</span></h1><p>Vaše polazište za solarnu energiju. Pouzdane informacije, praktični vodiči i alati za korak prema vlastitoj elektrani.</p><a class="button button-gold" href="/solarni-kalkulator/"><Icon name="calculator"/> Izračunajte svoj solarni potencijal <Icon name="arrow"/></a><div class="hero-note"><Icon name="check" size={16}/> Besplatno i bez registracije <span>·</span> Rezultat odmah</div></div><div class="hero-visual"><Picture src={landscape} alt="Sunčeve zrake iznad solarnih panela u zelenom krajoliku" formats={['avif','webp']} widths={[640,960,1440]} sizes="(max-width: 760px) 100vw, 52vw" width={1000} height={740} loading="eager" fetchpriority="high"/><div class="photo-shade"></div><div class="hero-caption"><span class="caption-icon"><Icon name="sun" size={29}/></span><div><strong>Dobra energija počinje dobrom odlukom.</strong><span>Iskoristite potencijal sunca na svojem krovu.</span></div></div><span class="photo-index">01 / SUNČEVA ENERGIJA</span></div></div></section>
  <section class="benefits" aria-label="Što pruža Solarni portal"><div class="container benefits-grid"><div><Icon name="shield" size={27}/><span><strong>Jasne i provjerljive informacije</strong><small>Razumljivo, uz poveznice na izvore</small></span></div><div><Icon name="calculator" size={27}/><span><strong>Vaš solarni potencijal</strong><small>Informativna procjena u nekoliko koraka</small></span></div><div><Icon name="leaf" size={27}/><span><strong>Korak prema održivosti</strong><small>Manje ovisnosti. Više vlastite energije.</small></span></div></div></section>
  <section class="container editorial"><div class="news-column"><div class="section-heading"><div><div class="eyebrow">ZNANJE KOJE POKREĆE PROMJENU</div><h2>Aktualnosti i korisni savjeti</h2></div><a class="text-link" href="/clanci/">Svi članci <Icon name="arrow" size={18}/></a></div><div class="home-articles">{articles.slice(0,3).map(article=><ArticleCard article={article}/>)}</div></div><aside class="quick-links"><h2>Brzi pristup</h2><a href="/solarna-energija/"><span class="quick-icon"><Icon name="sun"/></span><span>Osnove solarne energije<small>Sve počinje razumijevanjem</small></span><Icon name="chevron" size={16}/></a><a href="/poticaji/"><span class="quick-icon"><Icon name="coins"/></span><span>Poticaji i financiranje<small>Informirajte se o mogućnostima</small></span><Icon name="chevron" size={16}/></a><a href="/clanci/solarni-paneli-za-obiteljsku-kucu/"><span class="quick-icon"><Icon name="document"/></span><span>Od ideje do elektrane<small>Vodič kroz korake ugradnje</small></span><Icon name="chevron" size={16}/></a><a href="/cesta-pitanja/"><span class="quick-icon"><Icon name="book"/></span><span>Česta pitanja<small>Odgovori na jednom mjestu</small></span><Icon name="chevron" size={16}/></a><div class="aside-note"><Icon name="leaf" size={22}/><p>Odluke danas.<br/><strong>Čišća energija sutra.</strong></p></div></aside></section>
  <section class="topics-section"><div class="container"><div class="section-heading"><div><div class="eyebrow">OD PRVOG PITANJA DO VLASTITE ELEKTRANE</div><h2>Istražite solarnu energiju</h2></div><p>Prave informacije u svakom koraku.</p></div><div class="topics-grid">{[{n:'01',icon:'home',title:'Solarni paneli za vaš dom',desc:'Kako funkcioniraju, što vam je potrebno i odakle krenuti.',href:'/solarna-energija/'},{n:'02',icon:'coins',title:'Ulaganje i financiranje',desc:'Razumijte troškove i provjerite mogućnosti sufinanciranja.',href:'/poticaji/'},{n:'03',icon:'bolt',title:'Proizvodnja i ušteda',desc:'Saznajte koliko energije može proizvesti vaš krov.',href:'/solarni-kalkulator/'}].map(topic=><a class="topic-card" href={topic.href}><div class="topic-top"><Icon name={topic.icon} size={30}/><span>{topic.n}</span></div><h3>{topic.title}</h3><p>{topic.desc}</p><span class="topic-arrow"><Icon name="arrow"/></span></a>)}</div></div></section>
  <section class="container"><div class="bottom-cta"><div class="cta-symbol"><Icon name="sun" size={47}/></div><div><h2>Koliko sunca stane na vaš krov?</h2><p>Saznajte okvirnu snagu elektrane, proizvodnju i moguću godišnju uštedu.</p></div><a class="button button-gold" href="/solarni-kalkulator/">Otvorite solarni kalkulator <Icon name="arrow"/></a></div></section>
</Layout>
