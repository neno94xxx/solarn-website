---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ContentImage from '../../components/ContentImage.astro';
import { publishedArticle, publishedArticles, originalArticles } from '../../lib/server/articles';
export const prerender=false;
let article;
try {article=await publishedArticle(Astro.params.slug||'');}
catch {return new Response('Članak trenutačno nije dostupan. Pokušajte ponovno.',{status:503,headers:{'Content-Type':'text/plain; charset=utf-8','Retry-After':'60','Cache-Control':'no-store'}});}
if(!article){Astro.response.status=404;Astro.response.headers.set('X-Robots-Tag','noindex');}
let related=originalArticles;
if(article){try{related=await publishedArticles();}catch{/* Existing guides remain available during a database outage. */}}
const social=article?('variants' in article.image?article.image.variants.at(-1)!.url:article.image.src):'/social-card.jpg';
const schema=article?{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,datePublished:article.date,dateModified:article.updated_at||article.date,image:new URL(social,Astro.site).href,author:{'@type':'Organization',name:'Uredništvo Solarnog portala',url:new URL('/o-portalu/',Astro.site).href},publisher:{'@type':'Organization',name:'Solarni portal'},mainEntityOfPage:new URL(`/clanci/${article.slug}/`,Astro.site).href,inLanguage:'hr'}:undefined;
---
<Layout title={article?.title||'Članak nije pronađen'} description={article?.description||'Traženi članak nije dostupan. Istražite ostale vodiče i članke na Solarnom portalu.'} image={social} article={!!article} schema={schema} noindex={!article}>
{article ? <><div class="page-tint"><div class="container"><div class="breadcrumb"><a href="/">Naslovnica</a><Icon name="chevron" size={12}/><a href="/clanci/">Vodiči i članci</a><Icon name="chevron" size={12}/><span>{article.category}</span></div><div class="page-heading"><div class="article-info"><span class="category">{article.category}</span><time datetime={article.date}>{article.dateLabel}</time><span><Icon name="clock" size={13}/> {article.read} min čitanja</span></div><h1 class="article-title">{article.title}</h1><p>{article.description}</p></div></div></div><div class="container content-section"><div class="prose-layout"><article class="prose"><ContentImage image={article.image} alt={article.alt} cover class="article-cover"/>{article.sections?.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}{article.blocks?.map(block=>block.type==='heading'?<h2>{block.text}</h2>:block.type==='text'?<div class="article-text">{block.text?.split(/\n\s*\n/).map(paragraph=><p style="white-space:pre-line">{paragraph}</p>)}</div>:block.image&&<figure class="content-figure"><ContentImage image={block.image} alt={block.alt||''}/>{block.caption&&<figcaption>{block.caption}</figcaption>}</figure>)}{article.source&&<div class="source-box">Dodatne informacije: <a href={article.source} target="_blank" rel="noopener noreferrer">{article.sourceLabel} <Icon name="external" size={13}/></a></div>}<p class="article-byline">Pripremilo: Uredništvo Solarnog portala.</p></article><aside class="info-box"><Icon name="calculator" size={30}/><h2>Od informacija do vaše procjene.</h2><p>Izračunajte okvirnu snagu i proizvodnju elektrane za svoj dom.</p><a href="/solarni-kalkulator/" class="button button-gold">Solarni kalkulator <Icon name="arrow" size={18}/></a></aside></div><section class="related"><h2>Možda vas zanima i</h2><div class="home-articles">{related.filter(item=>item.slug!==article.slug).slice(0,3).map(item=><ArticleCard article={item}/>)}</div></section></div></> : <div class="container content-section"><div class="page-heading"><h1>Članak nije pronađen.</h1><p>Ovaj članak nije objavljen ili poveznica više nije dostupna.</p></div><a class="button button-gold" href="/clanci/">Pogledajte sve članke <Icon name="arrow"/></a></div>}
</Layout>
<style>.content-figure{margin:30px 0}.content-figure :global(img){width:100%;height:auto;border-radius:3px}.content-figure figcaption{font-size:12px;color:var(--muted);margin-top:9px}.article-byline{font-size:12px;margin-top:30px}</style>
