---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { regions } from '../lib/calculator.mjs';
---
<Layout title="Solarni kalkulator – izračun snage, proizvodnje i uštede" description="Besplatni solarni kalkulator za Hrvatsku. Izračunajte okvirnu snagu elektrane, broj panela, godišnju proizvodnju, uštedu i jednostavan povrat ulaganja.">
  <div class="page-tint"><div class="container"><div class="breadcrumb"><a href="/">Naslovnica</a><Icon name="chevron" size={12}/><span>Solarni kalkulator</span></div><div class="page-heading"><div class="eyebrow">VAŠ KROV. VAŠA ENERGIJA.</div><h1>Koliki je vaš solarni potencijal?</h1><p>Unesite nekoliko podataka o svojem domu i saznajte što vam sunce može donijeti. Informativan izračun, bez registracije i ostavljanja kontakta.</p></div></div></div>
  <div class="container content-section"><div class="calculator-layout"><form id="solar-form" class="calculator-form"><fieldset class="form-section"><legend><span class="step-number">01</span> Vaš dom i potrošnja</legend><div class="form-grid"><div class="field field-full"><label for="region">Gdje se nalazi vaš objekt?</label><select id="region" name="region">{Object.entries(regions).map(([value,region])=><option value={value}>{region.label}</option>)}</select></div><div class="field"><label for="consumption">Godišnja potrošnja (kWh)</label><input type="number" id="consumption" name="consumption" min="500" max="50000" step="100" value="5000" required/><small>Ukupno s računa za posljednjih 12 mjeseci.</small></div><div class="field"><label for="tariff">Cijena energije (€/kWh)</label><input type="number" id="tariff" name="tariff" min="0.01" max="1" step="0.01" value="0.16" required/><small>Promjenjivi trošak, bez fiksnih naknada.</small></div></div></fieldset>
  <fieldset class="form-section"><legend><span class="step-number">02</span> Vaš krov</legend><div class="form-grid"><div class="field"><label for="area">Raspoloživa površina (m²)</label><input type="number" id="area" name="area" min="5" max="500" step="1" value="40" required/><small>Iskoristiva površina bez prepreka.</small></div><div class="field"><label for="orientation">Orijentacija krova</label><select id="orientation" name="orientation"><option value="south">Jug</option><option value="southeast">Jugoistok</option><option value="southwest">Jugozapad</option><option value="east">Istok</option><option value="west">Zapad</option><option value="north">Sjever</option></select></div><div class="field field-full"><div class="range-label"><label for="selfUse">Izravna potrošnja proizvedene energije</label><output id="self-use-output" for="selfUse">40 %</output></div><input type="range" id="selfUse" name="selfUse" min="10" max="100" step="5" value="40"/><small>Udio proizvodnje koji trošite odmah u kućanstvu, bez baterije.</small></div></div></fieldset>
  <details class="advanced"><summary>Prilagodite trošak, potporu i dodatne pretpostavke</summary><div class="form-grid"><div class="field"><label for="unitCost">Cijena ugradnje (€/kWp)</label><input type="number" id="unitCost" name="unitCost" min="500" max="3000" step="50" value="1300" required/></div><div class="field"><label for="subsidy">Odobrena potpora (%)</label><input type="number" id="subsidy" name="subsidy" min="0" max="80" step="1" value="0" required/><small>Unesite samo potvrđeni udio potpore.</small></div><div class="field"><label for="exportPrice">Vrijednost viška (€/kWh)</label><input type="number" id="exportPrice" name="exportPrice" min="0" max="1" step="0.01" value="0" required/><small>Provjerite svoj ugovor s opskrbljivačem.</small></div><div class="field"><label for="shade">Gubitak zbog sjene (%)</label><input type="number" id="shade" name="shade" min="0" max="50" step="1" value="0" required/></div></div></details>
  <p id="form-error" class="error-message" role="alert" hidden></p><button type="submit" class="button button-gold"><Icon name="calculator"/> Izračunajte solarni potencijal <Icon name="arrow"/></button><p class="form-footnote"><Icon name="shield" size={13}/> Vaši podaci ostaju u vašem pregledniku.</p><noscript><p>Za interaktivni izračun uključite JavaScript u pregledniku.</p></noscript></form>
  <section class="results-panel" id="results" aria-label="Rezultat izračuna" tabindex="-1"><div class="results-eyebrow"><Icon name="sun" size={17}/> ENERGIJA VAŠEG DOMA</div><h2>Vaša solarna procjena</h2><p>Prvi korak prema informiranoj odluci.</p><div id="results-empty" class="results-empty"><Icon name="sun" size={65}/><h3>Svaki krov ima svoju priču.</h3><p>Unesite podatke i otkrijte potencijal svojeg krova za proizvodnju čiste energije.</p></div><div id="results-content" hidden><p id="result-status" class="result-update" role="status" aria-live="polite"></p><div class="results-grid"><div class="result-stat"><strong id="result-power"></strong><span>Predložena snaga elektrane</span></div><div class="result-stat"><strong id="result-production"></strong><span>Godišnja proizvodnja</span></div><div class="result-stat"><strong id="result-savings"></strong><span>Godišnja korist od energije</span></div><div class="result-stat"><strong id="result-payback"></strong><span>Jednostavan povrat ulaganja</span></div></div><div class="result-details"><p id="result-panels"></p><p id="result-investment"></p><p id="result-energy"></p><p id="result-roof"></p></div><div class="chart" id="monthly-chart" role="img" aria-label="Ilustrativna mjesečna raspodjela proizvodnje"></div><p class="chart-caption">Ilustrativna raspodjela proizvodnje po mjesecima. Nije meteorološka prognoza.</p></div><div class="results-bottom"><Icon name="shield" size={17}/><span>Informativna procjena. Bez obveze i registracije.</span></div></section></div>
  <section class="methodology"><h2>Kako računamo?</h2><p>Koristimo pojednostavljene radne pretpostavke godišnjeg prinosa: 1.100 kWh/kWp za kontinentalni dio, 1.250 za Istru i Kvarner, 1.400 za Dalmaciju te 1.050 za Gorsku Hrvatsku i Liku. To nisu podaci za vašu adresu niti rezultat upita PVGIS-u. Pretpostavljen je krov nagiba približno 30–35°; orijentacija i unesena sjena umanjuju prinos. Panel ima 450 W i zauzima približno 2,2 m².</p><p>Godišnja korist = izravno potrošena energija × vaša cijena energije + višak × unesena vrijednost viška. Višak je početno vrednovan s 0 €. Ugradnja je početno postavljena na ilustrativnih 1.300 €/kWp; unesite stvarnu ponudu. Jednostavan povrat ne uključuje financiranje, održavanje, degradaciju panela, zamjenu opreme, bateriju ni buduće promjene cijena. Mjesečni graf koristi fiksnu ilustrativnu sezonsku raspodjelu.</p><p>Rezultat nije ponuda niti jamstvo proizvodnje. Za precizniju procjenu koristite <a href="https://joint-research-centre.ec.europa.eu/pvgis-online-tool_en" target="_blank" rel="noopener noreferrer">PVGIS Europske komisije</a> i ovlaštenog projektanta.</p></section></div>
  <script>
    import { calculateSolar } from '../lib/calculator.mjs';
    const form = document.querySelector<HTMLFormElement>('#solar-form')!;
    const range = document.querySelector<HTMLInputElement>('#selfUse')!;
    range.addEventListener('input',()=>{document.querySelector('#self-use-output')!.textContent = `${range.value} %`;});
    const number = (value: number, digits = 0) => new Intl.NumberFormat('hr-HR',{maximumFractionDigits:digits}).format(value);
    const set = (id: string, value: string) => {document.getElementById(id)!.textContent=value;};
    form.addEventListener('invalid', (event)=>{if ((event.target as HTMLElement).closest('.advanced')) document.querySelector<HTMLDetailsElement>('.advanced')!.open = true;},true);
    form.addEventListener('submit', event => {
      event.preventDefault();
      const error = document.querySelector<HTMLElement>('#form-error')!;
      error.hidden = true;
      const values = Object.fromEntries(new FormData(form));
      try {
        const result = calculateSolar({region:String(values.region),orientation:String(values.orientation),consumption:Number(values.consumption),area:Number(values.area),tariff:Number(values.tariff),selfUse:Number(values.selfUse),unitCost:Number(values.unitCost),subsidy:Number(values.subsidy),exportPrice:Number(values.exportPrice),shade:Number(values.shade)});
        document.querySelector<HTMLElement>('#results-empty')!.hidden = true;
        document.querySelector<HTMLElement>('#results-content')!.hidden = false;
        set('result-power',`${number(result.power,2)} kWp`);
        set('result-production',`${number(result.production)} kWh`);
        set('result-savings',`${number(result.savings)} €`);
        set('result-payback',result.payback === null ? 'Nije dostupan' : `${number(result.payback,1)} god.`);
        set('result-panels',`${result.panelCount} panela od 450 W · približno ${number(result.area,1)} m² krova`);
        set('result-investment',`Okvirno ulaganje nakon unesene potpore: ${number(result.investment)} €`);
        set('result-energy',`Izravna potrošnja: ${number(result.used)} kWh · višak: ${number(result.exported)} kWh godišnje.`);
        set('result-roof',result.roofLimited ? 'Raspoloživa površina krova ograničava predloženu snagu.' : 'Predložena snaga stane na unesenu raspoloživu površinu.');
        const chart = document.querySelector('#monthly-chart')!;
        chart.replaceChildren();
        const months = ['Sij','Velj','Ožu','Tra','Svi','Lip','Srp','Kol','Ruj','Lis','Stu','Pro'];
        result.monthly.forEach((value: number,index: number)=>{ const bar=document.createElement('div');bar.className='chart-bar';bar.title=`${months[index]}: ${number(value)} kWh`;const fill=document.createElement('span');fill.style.height=`${value/Math.max(...result.monthly)*85}%`;const label=document.createElement('small');label.textContent=months[index];bar.append(fill,label);chart.append(bar); });
        chart.setAttribute('aria-label',`Ilustrativna mjesečna proizvodnja: ${result.monthly.map((value: number,index: number)=>`${months[index]} ${number(value)} kWh`).join(', ')}`);
        set('result-status',`Izračun dovršen. Predložena snaga ${number(result.power,2)} kWp, proizvodnja ${number(result.production)} kWh godišnje.`);
        if (matchMedia('(max-width: 760px)').matches) {document.querySelector<HTMLElement>('#results')!.focus({preventScroll:true});document.querySelector('#results')!.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});}
      } catch (e) {error.textContent = e instanceof Error ? e.message : 'Provjerite unesene podatke.';error.hidden = false;}
    });
  </script>
</Layout>
