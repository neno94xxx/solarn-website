---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { supabaseConfig } from '../../lib/server/supabase';
export const prerender=false;
const configured=!!supabaseConfig();
---
<AdminLayout title="Prijava" login><div class="login-panel"><div class="login-intro"><span class="login-sun"><Icon name="sun" size={46}/></span><div class="eyebrow">DOBRO DOŠLI U UREDNIŠTVO</div><h1>Dobar sadržaj.<br/>Dobra energija.</h1><p>Mjesto za vaše priče, stručne savjete i novosti o solarnoj energiji.</p><div class="login-security"><Icon name="shield" size={21}/><span>Pristup samo ovlaštenim urednicima.</span></div></div><div class="login-form-panel"><h2>Prijavite se</h2><p>Unesite podatke svog administratorskog računa.</p>{!configured&&<div class="admin-notice" role="status"><strong>Još jedan korak do uredništva</strong><p>Pokrenite <code>supabase-setup.txt</code> u novom Supabase projektu i unesite URL i javni ključ u <code>.env</code>. Zatim ponovno pokrenite poslužitelj.</p></div>}<form id="login-form"><div class="field"><label for="email">E-mail adresa</label><input id="email" name="email" type="email" autocomplete="username" required maxlength="254" placeholder="vas@email.hr" disabled={!configured}/></div><div class="field"><label for="password">Lozinka</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" disabled={!configured}/></div><p class="admin-error" id="login-error" role="alert" hidden></p><button type="submit" class="button button-gold" disabled={!configured}>Prijavi se <Icon name="arrow"/></button></form><p class="login-help">Račune i pristup dodjeljuje vlasnik portala.</p></div></div><script>
const form=document.querySelector<HTMLFormElement>('#login-form')!;
form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button')!;const error=document.querySelector<HTMLElement>('#login-error')!;button.disabled=true;button.textContent='Prijava…';error.hidden=true;try{const values=new FormData(form);const response=await fetch('/api/admin/session/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(values))});const data=await response.json();if(!response.ok)throw new Error(data.error||'Prijava nije uspjela.');location.assign('/admin/');}catch(e){error.textContent=e instanceof Error?e.message:'Provjerite internetsku vezu.';error.hidden=false;button.disabled=false;button.textContent='Prijavi se';}});
</script></AdminLayout>
