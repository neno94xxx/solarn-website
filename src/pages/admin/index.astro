---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
export const prerender=false;
---
<AdminLayout title="Članci"><div class="admin-page-heading"><div><div class="eyebrow">VAŠE UREDNIŠTVO</div><h1>Članci</h1><p>Upravljajte pričama koje se prikazuju na Solarnom portalu.</p></div><a class="button button-gold" href="/admin/urednik/">+ Novi članak</a></div><div class="admin-stats"><div><span>Svi članci</span><strong id="count-all">—</strong></div><div><span>Objavljeno</span><strong id="count-published">—</strong></div><div><span>Nacrti</span><strong id="count-draft">—</strong></div></div><section class="admin-list-panel"><div class="admin-list-tools"><div class="filter-buttons" role="group" aria-label="Status članaka"><button data-status="all" class="filter-button" aria-pressed="true">Svi članci</button><button data-status="published" class="filter-button" aria-pressed="false">Objavljeno</button><button data-status="draft" class="filter-button" aria-pressed="false">Nacrti</button></div><label class="admin-search-label"><span class="sr-only">Pretraži članke</span><input id="admin-search" type="search" placeholder="Pronađite članak…"/></label></div><div id="article-list" class="admin-article-list" aria-live="polite"><p class="admin-loading">Učitavanje članaka…</p></div><p id="list-error" class="admin-error" role="alert" hidden></p><button id="retry-list" class="button button-navy" hidden>Pokušaj ponovno</button></section><div class="admin-guide"><Icon name="book" size={24}/><p><strong>Od nacrta do naslovnice.</strong> Nacrt vidite samo u administraciji. Klikom na „Objavi članak” sadržaj postaje dostupan na portalu; tri najnovija članka prikazuju se na naslovnici. Početni vodiči ostaju dio portala.</p></div><script>
type Row={id:string;title:string;category:string;status:string;slug:string;updated_at:string;};let rows:Row[]=[];let status='all';const list=document.querySelector<HTMLElement>('#article-list')!;const search=document.querySelector<HTMLInputElement>('#admin-search')!;
function render(){list.replaceChildren();const visible=rows.filter(row=>(status==='all'||row.status===status)&&row.title.toLocaleLowerCase('hr').includes(search.value.toLocaleLowerCase('hr')));if(!visible.length){const box=document.createElement('div');box.className='admin-empty';const title=document.createElement('h2');title.textContent=rows.length?'Nema članaka za ovaj odabir.':'Vaša sljedeća priča počinje ovdje.';const text=document.createElement('p');text.textContent=rows.length?'Promijenite pojam pretrage ili status.':'Dodajte prvi članak, fotografiju i nekoliko riječi za svoje čitatelje.';box.append(title,text);if(!rows.length){const link=document.createElement('a');link.href='/admin/urednik/';link.className='button button-gold';link.textContent='Napišite prvi članak';box.append(link);}list.append(box);return;}for(const row of visible){const item=document.createElement('article');item.className='admin-article-row';const body=document.createElement('div');const badge=document.createElement('span');badge.className=`admin-badge ${row.status}`;badge.textContent=row.status==='published'?'Objavljeno':'Nacrt';const link=document.createElement('a');link.href=`/admin/urednik/?id=${row.id}`;const title=document.createElement('h2');title.textContent=row.title;link.append(title);const meta=document.createElement('p');meta.textContent=`${row.category} · Izmijenjeno ${new Intl.DateTimeFormat('hr-HR',{dateStyle:'medium'}).format(new Date(row.updated_at))}`;body.append(badge,link,meta);const actions=document.createElement('div');actions.className='row-actions';const edit=document.createElement('a');edit.href=link.href;edit.textContent='Uredi →';actions.append(edit);if(row.status==='published'){const view=document.createElement('a');view.href=`/clanci/${row.slug}/`;view.target='_blank';view.rel='noopener';view.textContent='Pogledaj ↗';actions.append(view);}item.append(body,actions);list.append(item);}}
async function load(){const error=document.querySelector<HTMLElement>('#list-error')!;const retry=document.querySelector<HTMLButtonElement>('#retry-list')!;error.hidden=true;retry.hidden=true;try{const response=await fetch('/api/admin/articles/');if(response.status===401){location.assign('/admin/prijava/');return;}const data=await response.json();if(!response.ok)throw new Error(data.error);rows=data.articles;document.querySelector('#count-all')!.textContent=String(rows.length);document.querySelector('#count-published')!.textContent=String(rows.filter(row=>row.status==='published').length);document.querySelector('#count-draft')!.textContent=String(rows.filter(row=>row.status==='draft').length);render();}catch(e){list.replaceChildren();error.textContent=e instanceof Error?e.message:'Članci se ne mogu učitati.';error.hidden=false;retry.hidden=false;}}
document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button=>button.addEventListener('click',()=>{status=button.dataset.status!;document.querySelectorAll('[data-status]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));render();}));search.addEventListener('input',render);document.querySelector('#retry-list')?.addEventListener('click',load);void load();
</script></AdminLayout>
