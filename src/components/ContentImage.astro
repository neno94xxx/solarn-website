---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MediaAsset } from '../lib/server/articles';
interface Props { image:ImageMetadata|MediaAsset;alt:string;cover?:boolean;class?:string; }
const {image,alt,cover=false,class:className}=Astro.props;
const remote='variants' in image;
const largest=remote?image.variants.at(-1):null;
---
{remote&&largest ? <img src={largest.url} srcset={image.variants.map(variant=>`${variant.url} ${variant.width}w`).join(', ')} sizes={cover?'(max-width: 900px) 100vw, 65vw':'(max-width: 600px) 100vw, 33vw'} alt={alt} width={image.width} height={image.height} loading={cover?'eager':'lazy'} decoding="async" class={className}/> : !remote&&<Picture src={image} alt={alt} formats={['avif','webp']} widths={cover?[480,800,1200]:[320,480,720]} sizes={cover?'(max-width: 900px) 100vw, 65vw':'(max-width: 600px) 100vw, 33vw'} width={cover?800:600} height={cover?430:370} loading={cover?'eager':'lazy'} class={className}/>}
